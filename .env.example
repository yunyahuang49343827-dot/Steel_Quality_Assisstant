# =========================================================
# Steel Quality Intelligence
# Environment Configuration Example
# =========================================================


# =========================================================
# Application
# =========================================================

APP_ENV=development

API_HOST=0.0.0.0
API_PORT=8000


# =========================================================
# Local PostgreSQL
#
# Used when Python runs directly on the Mac.
# =========================================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=steel_quality

DB_USER=your_local_postgres_user
DB_PASSWORD=


# =========================================================
# Docker PostgreSQL
#
# Used by Docker Compose.
#
# Do NOT commit real production credentials.
# =========================================================

POSTGRES_DB=steel_quality
POSTGRES_USER=steel_app
POSTGRES_PASSWORD=change_me


# =========================================================
# Ollama
#
# Local Python:
# http://127.0.0.1:11434
#
# Docker backend overrides this to:
# http://host.docker.internal:11434
# =========================================================

OLLAMA_BASE_URL=http://127.0.0.1:11434

OLLAMA_MODEL=qwen3.5:9b


# =========================================================
# Frontend / API
# =========================================================

FRONTEND_PORT=5173

BACKEND_HOST_PORT=8000

POSTGRES_HOST_PORT=5433


# =========================================================
# CORS
# =========================================================

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173